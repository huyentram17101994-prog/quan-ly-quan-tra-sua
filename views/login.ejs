<!DOCTYPE html>
<html>
<head>
    <title>Đăng nhập hệ thống</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        body{
            height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background: linear-gradient(135deg,#6dd5ed,#2193b0);
            font-family: Arial;
        }

        .login-box{
            width:400px;
            background:white;
            padding:40px;
            border-radius:20px;
            box-shadow:0 10px 30px rgba(0,0,0,0.2);
        }

        .login-title{
            text-align:center;
            margin-bottom:30px;
            font-weight:bold;
            color:#2193b0;
        }

        .btn-login{
            width:100%;
            border-radius:10px;
            padding:10px;
            font-size:18px;
        }

        .logo{
            font-size:60px;
            text-align:center;
            margin-bottom:10px;
        }

    </style>
</head>

<body>

<div class="login-box">

    <div class="logo">
        🧋
    </div>

    <h2 class="login-title">
        Đăng nhập hệ thống
    </h2>

    <form method="POST" action="/login">

        <div class="mb-3">
            <label class="form-label">
                Username
            </label>

            <input
                type="text"
                name="username"
                class="form-control"
                placeholder="Nhập username"
                required
            >
        </div>

        <div class="mb-4">
            <label class="form-label">
                Password
            </label>

            <input
                type="password"
                name="password"
                class="form-control"
                placeholder="Nhập password"
                required
            >
        </div>

        <button class="btn btn-primary btn-login">
            🔐 Đăng nhập
        </button>

    </form>

</div>

</body>
</html>