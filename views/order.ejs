<!DOCTYPE html>
<html>
<head>
    <title>Bán hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container-fluid mt-3">
<div class="row">

    <!-- 🧋 DANH SÁCH SẢN PHẨM -->
    <div class="col-md-8">
        <h4>🧋 Menu trà sữa</h4>
        <div class="row">

            <% sanpham.forEach(sp => { %>
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">

                    <img src="<%= sp.HinhAnh || 'https://source.unsplash.com/300x200/?milk-tea' %>" 
                         class="card-img-top"
                         style="height:200px; object-fit:cover;">

                    <div class="card-body text-center">
                        <h6><%= sp.TenSP %></h6>
                        <p class="text-danger"><%= sp.DonGia %> đ</p>

                        <a href="/orders/add/<%= sp.MaSP %>" 
                           class="btn btn-success">
                           ➕ Thêm
                        </a>
                    </div>

                </div>
            </div>
            <% }) %>

        </div>
    </div>

    <!-- 🧾 HÓA ĐƠN -->
    <div class="col-md-4">
        <h4>🧾 Hóa đơn #<%= MaHD %></h4>

        <table class="table table-bordered">
            <tr>
                <th>Tên</th>
                <th>SL</th>
                <th>Giá</th>
                <th>Xóa</th>
            </tr>

            <% let tong = 0; %>

            <% chitiet.forEach(ct => { %>
            <tr>
                <td><%= ct.TenSP %></td>
                <td><%= ct.SoLuong %></td>
                <td><%= ct.DonGia %></td>
                <td>
                    <a href="/orders/delete/<%= MaHD %>/<%= ct.MaSP %>"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Xóa món này?')">
                       ❌
                    </a>
                </td>
            </tr>
            <% tong += ct.SoLuong * ct.DonGia; %>
            <% }) %>
        </table>

        <!-- 💰 TỔNG TIỀN -->
        <h5 class="text-end text-danger">
            Tổng: <%= tong %> đ
        </h5>

        <!-- 💰 THANH TOÁN -->
        <form method="POST" action="/orders/pay">
            <button class="btn btn-success w-100 mt-2">
                💰 Thanh toán
            </button>
        </form>

        <!-- 🔙 QUAY LẠI -->
        <a href="/products" class="btn btn-secondary w-100 mb-2">
    Quay lại
    </a>

        <a href="/orders/cancel/<%= MaHD %>" 
           class="btn btn-danger w-100"
           onclick="return confirm('Bạn có chắc muốn hủy hóa đơn?')">
           ❌ Hủy hóa đơn
        </a>
    </div>

</div>
</div>

</body>
</html>