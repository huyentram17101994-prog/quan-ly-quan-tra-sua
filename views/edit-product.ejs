<!DOCTYPE html>
<html>
<head>
    <title>Sửa sản phẩm</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card p-4 shadow">

        <h3 class="mb-4">
            ✏️ Sửa sản phẩm
        </h3>

        <form method="POST" action="/products/update/<%= sp.MaSP %>">

            <div class="mb-3">
                <label>Tên sản phẩm</label>

                <input
                    type="text"
                    name="TenSP"
                    class="form-control"
                    value="<%= sp.TenSP %>"
                >
            </div>

            <div class="mb-3">
                <label>Đơn giá</label>

                <input
                    type="number"
                    name="DonGia"
                    class="form-control"
                    value="<%= sp.DonGia %>"
                >
            </div>

            <button class="btn btn-primary">
                💾 Cập nhật
            </button>

            <a href="/products" class="btn btn-secondary">
                Quay lại
            </a>

        </form>

    </div>

</div>

</body>
</html>